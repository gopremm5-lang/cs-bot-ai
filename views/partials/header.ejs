<header>
  <nav>
    <div class="nav-left">
      <button id="sidebarToggle" class="btn-ghost" type="button">☰</button>
      <span class="nav-title">Vylozzone Admin Panel</span>
    </div>

    <div class="nav-menu">
      <a href="/dashboard" class="<%= active==='dashboard'?'active':'' %>">Dashboard</a>
      <a href="/produk"    class="<%= active==='produk'?'active':'' %>">Produk</a>
      <a href="/faq"       class="<%= active==='faq'?'active':'' %>">FAQ</a>
      <a href="/sop"       class="<%= active==='sop'?'active':'' %>">SOP</a>
      <a href="/promo"     class="<%= active==='promo'?'active':'' %>">Promo</a>
      <a href="/claims"    class="<%= active==='claims'?'active':'' %>">Claim</a>
      <a href="/blacklist" class="<%= active==='blacklist'?'active':'' %>">Blacklist</a>
      <a href="/buyers"    class="<%= active==='buyers'?'active':'' %>">User Royal</a>
      <a href="/stock"     class="<%= active==='stock'?'active':'' %>">Stock</a>
      <a href="/claims-replace" class="<%= active==='claims-replace'?'active':'' %>">Claim Replace</a>
      <a href="/reset"     class="<%= active==='reset'?'active':'' %>">Reset</a>
      <a href="/logout"    class="text-danger">Logout</a>
    </div>
  </nav>

  <link rel="stylesheet" href="/css/style.css" />
  <script>
    // toggle sidebar (tambahan kecil biar bisa disembunyikan)
    document.addEventListener('DOMContentLoaded', function(){
      var btn = document.getElementById('sidebarToggle');
      var sb  = document.querySelector('.sidebar');
      if (btn && sb){
        btn.addEventListener('click', function(){ sb.classList.toggle('is-hidden'); });
      }
    });
  </script>
</header>
