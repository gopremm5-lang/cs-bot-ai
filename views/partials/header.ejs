<header>
  <nav>
    <div class="nav-left">
      <button id="sidebarToggle" class="btn-ghost" type="button">☰</button>
      <span class="nav-title">Vylozzone Admin Panel</span>
    </div>

    <div class="nav-menu">
        <a href="/dashboard" class="<%= typeof active!== 'undefined' && active==='dashboard' ? 'active' : '' %>">Dashboard</a>
        <a href="/produk"    class="<%= typeof active!== 'undefined' && active==='produk' ? 'active' : '' %>">Produk</a>
        <a href="/faq"       class="<%= typeof active!== 'undefined' && active==='faq' ? 'active' : '' %>">FAQ</a>
        <a href="/sop"       class="<%= typeof active!== 'undefined' && active==='sop' ? 'active' : '' %>">SOP</a>
        <a href="/promo"     class="<%= typeof active!== 'undefined' && active==='promo' ? 'active' : '' %>">Promo</a>
        <a href="/claims"    class="<%= typeof active!== 'undefined' && active==='claims' ? 'active' : '' %>">Claim</a>
        <a href="/blacklist" class="<%= typeof active!== 'undefined' && active==='blacklist' ? 'active' : '' %>">Blacklist</a>
        <a href="/buyers"    class="<%= typeof active!== 'undefined' && active==='buyers' ? 'active' : '' %>">User Royal</a>
        <a href="/stock"     class="<%= typeof active!== 'undefined' && active==='stock' ? 'active' : '' %>">Stock</a>
        <a href="/claims-replace" class="<%= typeof active!== 'undefined' && active==='claims-replace' ? 'active' : '' %>">Claim Replace</a>
        <a href="/reset"     class="<%= typeof active!== 'undefined' && active==='reset' ? 'active' : '' %>">Reset</a>
      <a href="/logout"    class="text-danger">Logout</a>
    </div>
  </nav>

  <link rel="stylesheet" href="/css/style.css" />
  <script>
    // toggle sidebar (tambahan kecil biar bisa disembunyikan)
    document.addEventListener('DOMContentLoaded', function(){
      var btn = document.getElementById('sidebarToggle');
      var sb  = document.querySelector('.sidebar');
      if (btn && sb){
        btn.addEventListener('click', function(){ sb.classList.toggle('is-hidden'); });
      }
    });
  </script>
</header>
